<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jenkins-ci.plugins</groupId>
        <artifactId>plugin</artifactId>
        <version>5.31</version>
        <relativePath />
    </parent>

    <groupId>org.jenkinsci.plugins</groupId>
    <artifactId>varroa-mite-auth</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>hpi</packaging>

    <name>Varroa Mite Authentication</name>

    <properties>
        <jenkins.version>2.555.3</jenkins.version>
        <!--
          Jenkins 2.555.x is a Java-21-only LTS line: jenkins-core 2.555.3 ships
          class-file-version-65 (Java 21) bytecode. The maven-hpi-plugin pinned by
          parent 5.31 (3.1784) depends on version-number 1.12, whose
          JavaSpecificationVersion.fromClassVersion() only maps up to class 64
          (Java 20) and throws "Unknown Java specification version for class
          version: 65" during the hpi:validate goal. Override the hpi-plugin to
          3.1814 (the version pinned by parent 6.2189), which depends on
          version-number 1.14 and maps class 65 -> Java 21. Build JDK must be 21.
        -->
        <hpi-plugin.version>3.1814.v77d15159f9b_d</hpi-plugin.version>
        <!--
          workflow-api's LogStorage and LogStorageFactory carry
          @Restricted(Beta.class). useBeta allows the access-modifier-checker
          goal to pass for that intentional, pinned-version usage.
        -->
        <useBeta>true</useBeta>
    </properties>

    <repositories>
        <repository>
            <id>repo.jenkins-ci.org</id>
            <url>https://repo.jenkins-ci.org/public/</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>repo.jenkins-ci.org</id>
            <url>https://repo.jenkins-ci.org/public/</url>
        </pluginRepository>
    </pluginRepositories>
    <dependencyManagement>
        <dependencies>
            <!--
              Align plugin dependency versions (incl. configuration-as-code and
              its test-harness) with the Jenkins 2.555.x baseline so the JCasC
              round-trip tests resolve a JCasC build compatible with core 2.555.3.
            -->
            <dependency>
                <groupId>io.jenkins.tools.bom</groupId>
                <artifactId>bom-2.555.x</artifactId>
                <version>6585.va_085f4d47c41</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>5.0.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
            <version>1.42.0</version>
        </dependency>

        <dependency>
            <groupId>org.jenkins-ci.plugins</groupId>
            <artifactId>mailer</artifactId>
        </dependency>

        <!-- Pipeline graph API for the build-event capture claim gate and
             stage extraction. Versions come from the imported BOM. -->
        <dependency>
            <groupId>org.jenkins-ci.plugins.workflow</groupId>
            <artifactId>workflow-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jenkins-ci.plugins.workflow</groupId>
            <artifactId>workflow-job</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jenkins-ci.plugins</groupId>
            <artifactId>pipeline-graph-analysis</artifactId>
        </dependency>

        <!-- Marker-based pipeline templates (D8, E2): the multibranch
             project factory and the marker/template flow definitions. -->
        <dependency>
            <groupId>org.jenkins-ci.plugins.workflow</groupId>
            <artifactId>workflow-multibranch</artifactId>
        </dependency>
        <!-- workflow-cps supplies GlobalVariable, which
             VarroaTemplateParams exposes varroaParams through, so this
             dependency is compile scope, not test scope. -->
        <dependency>
            <groupId>org.jenkins-ci.plugins.workflow</groupId>
            <artifactId>workflow-cps</artifactId>
        </dependency>
        <!-- workflow-step-api supplies Step and StepExecution, which the
             varroa global variable's four steps extend (D1, D17). -->
        <dependency>
            <groupId>org.jenkins-ci.plugins.workflow</groupId>
            <artifactId>workflow-step-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jenkins-ci.plugins</groupId>
            <artifactId>branch-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jenkins-ci.plugins</groupId>
            <artifactId>scm-api</artifactId>
        </dependency>
        <!-- Parses the pipeline-template marker file with the safe
             constructor (D8, task 5.13). -->
        <dependency>
            <groupId>io.jenkins.plugins</groupId>
            <artifactId>snakeyaml-api</artifactId>
        </dependency>

        <!-- Pipeline test harness: a scripted pipeline exercises the graph
             listener and the claim gate in tests only. -->
        <dependency>
            <groupId>org.jenkins-ci.plugins.workflow</groupId>
            <artifactId>workflow-basic-steps</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- The native `build` step, test scope only: a test runs
             `build job: 'B'` in both wait modes against the queue decision
             handler. No main-scope class names the step or its action, and
             the handler matches the action by its class simple name. -->
        <dependency>
            <groupId>org.jenkins-ci.plugins</groupId>
            <artifactId>pipeline-build-step</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Declarative Pipeline, test scope only (task 10.1): proves the
             `triggers { varroaUpstream(...) }` section binds
             VarroaUpstreamTrigger through its @Symbol, the same path a real
             Jenkinsfile uses. -->
        <dependency>
            <groupId>org.jenkinsci.plugins</groupId>
            <artifactId>pipeline-model-definition</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- The node step and its ContinuedTask PlaceholderTask (D12 build-identity
             tests): a real `node` block schedules a PlaceholderTask, which is not an
             Item, and only the owner-task resolution step reaches its owning job. -->
        <dependency>
            <groupId>org.jenkins-ci.plugins.workflow</groupId>
            <artifactId>workflow-durable-task-step</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- The `input` step, test scope only (D15a): the recorder finds the
             step's action and its executions by class name, so a test that
             proves a pending input reached an event needs the real classes.
             No main-scope class names the step. The BOM manages the version. -->
        <dependency>
            <groupId>org.jenkins-ci.plugins</groupId>
            <artifactId>pipeline-input-step</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Real folders for the D12 tenant-isolation tests (task 10.3c): MockFolder
             carries no folder-property support, so a folder-scoped credential needs
             the real Folder class. Compile scope, not test: WorkflowMultiBranchProject
             (workflow-multibranch, E2) extends branch-api's MultiBranchProject, which
             extends cloudbees-folder's ComputedFolder, so VarroaMarkerFlowDefinition's
             own compile-time reference to WorkflowMultiBranchProject needs the whole
             chain resolvable, not only at test scope. -->
        <dependency>
            <groupId>org.jenkins-ci.plugins</groupId>
            <artifactId>cloudbees-folder</artifactId>
        </dependency>

        <!-- The log-storage masking test (D1, task 6.8) proves credentials-binding's
             own masking runs before a byte reaches the log buffer. -->
        <dependency>
            <groupId>org.jenkins-ci.plugins</groupId>
            <artifactId>credentials-binding</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jenkins-ci.plugins</groupId>
            <artifactId>plain-credentials</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JCasC: required at runtime to configure the realm via a bundle;
             optional so the plugin still loads where JCasC is absent. -->
        <dependency>
            <groupId>io.jenkins</groupId>
            <artifactId>configuration-as-code</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- JCasC test harness (RealmConfigurator round-trip helpers). -->
        <dependency>
            <groupId>io.jenkins.configuration-as-code</groupId>
            <artifactId>test-harness</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Test-scope only (ruling u): boots the real artifact-manager-s3
             and aws-global-configuration JCasC configurators for the
             artifact-storage fragment round-trip test (task 6.10). The
             HPI carries no runtime dependency on either plugin; the
             operator's fragment targets whatever version a controller's
             version profile pins. Pinned to the versions task 0.5's
             compatibility spike used (review-log.md "Task 0.5"). -->
        <dependency>
            <groupId>io.jenkins.plugins</groupId>
            <artifactId>artifact-manager-s3</artifactId>
            <version>986.v7c9a_d15576b_b_</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.jenkins.plugins</groupId>
            <artifactId>aws-global-configuration</artifactId>
            <version>165.v712c4a_e4a_078</version>
            <scope>test</scope>
        </dependency>

        <!-- Mockito for endpoint tests. -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- role-strategy for the banner role-resolution regression test;
             production code resolves it reflectively and must keep working
             when it is absent. -->
        <dependency>
            <groupId>org.jenkins-ci.plugins</groupId>
            <artifactId>role-strategy</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- The D7 credential-scope test (task 5.12d) builds a real GitSCM
             against a local repository. git-plugin is not a compile
             dependency: production code reaches hudson.plugins.git.GitSCM
             reflectively, the way TemplateCredentialResolver reaches the
             credentials plugin. -->
        <dependency>
            <groupId>org.jenkins-ci.plugins</groupId>
            <artifactId>git</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- The run-source tests check a repository out by its local path.
             git-plugin refuses that checkout unless this property allows it. -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <hudson.plugins.git.GitSCM.ALLOW_LOCAL_CHECKOUT>true</hudson.plugins.git.GitSCM.ALLOW_LOCAL_CHECKOUT>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
