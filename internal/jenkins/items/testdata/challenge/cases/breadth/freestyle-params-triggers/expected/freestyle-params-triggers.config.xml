<?xml version="1.0" encoding="UTF-8"?>

<project>
  <displayName>FreeStyle Parameters and Triggers</displayName>
  <description>FreeStyle job with build parameters and SCM trigger</description>
  <triggers>
    <hudson.triggers.SCMTrigger>
      <spec>H/5 * * * *</spec>
    </hudson.triggers.SCMTrigger>
    <hudson.triggers.TimerTrigger>
      <spec>0 2 * * *</spec>
    </hudson.triggers.TimerTrigger>
  </triggers>
</project>