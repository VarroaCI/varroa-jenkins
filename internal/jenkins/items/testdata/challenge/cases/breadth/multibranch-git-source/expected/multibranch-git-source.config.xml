<?xml version="1.0" encoding="UTF-8"?>

<org.jenkinsci.plugins.workflow.multibranch.WorkflowMultiBranchProject plugin="workflow-multibranch">
  <displayName>Multibranch Git Source</displayName>
  <description>Multibranch pipeline with git source</description>
  <sources class="jenkins.branch.MultiBranchProject$BranchSourceList">
    <data>
      <jenkins.branch.BranchSource>
        <source class="jenkins.plugins.git.GitSCMSource" plugin="git">
          <remote>https://github.com/fake-org/multibranch-git.git</remote>
          <credentialsId>git-cred</credentialsId>
        </source>
        <buildStrategies>
          <jenkins.branch.buildstrategies.basic.SkipInitialBuildOnFirstBranchIndexing plugin="basic-branch-build-strategies"></jenkins.branch.buildstrategies.basic.SkipInitialBuildOnFirstBranchIndexing>
          <org.jenkinsci.plugins.varroamiteauth.VarroaPushedBranchBuildStrategy plugin="varroa-mite-auth"></org.jenkinsci.plugins.varroamiteauth.VarroaPushedBranchBuildStrategy>
        </buildStrategies>
      </jenkins.branch.BranchSource>
    </data>
  </sources>
  <factory class="org.jenkinsci.plugins.workflow.multibranch.WorkflowMultiBranchProjectFactory">
    <scriptPath>Jenkinsfile</scriptPath>
  </factory>
</org.jenkinsci.plugins.workflow.multibranch.WorkflowMultiBranchProject>